# Copy to .env and fill in as needed. Never commit the real .env file.
# Nothing here is required for local development — mock providers (added
# in V0) let the system run with no API keys at all.

# --- Backend (backend/.env or repo-root .env) ---
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./switchyard.db

# Provider API keys — leave blank to use mock providers only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
